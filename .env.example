APP_NAME=research-brief-agent
ENVIRONMENT=local

# Public-demo protection. API_KEYS is a comma-separated allow-list; leave empty
# for local development only. Non-local deployments require at least one key.
API_KEYS=
API_KEY_HEADER_NAME=X-API-Key
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Synthesis backend: anthropic (native Claude) or openai (OpenAI-compatible)
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.2

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI-compatible (OpenAI, DeepSeek, local models, OpenRouter, codex/opencode).
# Set OPENAI_BASE_URL to point at a non-OpenAI compatible endpoint.
# DeepSeek V4: LLM_PROVIDER=openai, OPENAI_BASE_URL=https://api.deepseek.com
# DeepSeek V4 thinking is disabled automatically by the OpenAI-compatible adapter
# so responses return normal assistant content/tool calls for the agent loop.
# Ollama (local): OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=

# Optional current-web evidence. The tool is exposed only for recency-sensitive
# questions, counts against the normal discovery budget, returns at most five
# highlighted sources, and never writes web pages to Qdrant.
WEB_SEARCH_ENABLED=true
EXA_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_S=12
WEB_SEARCH_HIGHLIGHT_CHARS=1200
# Comma-separated exact domains or parent domains. Results must use HTTPS and
# match this allow-list after Exa returns them.
WEB_SEARCH_ALLOWED_DOMAINS=openai.com,anthropic.com,deepmind.google,ai.google.dev,developers.googleblog.com,mistral.ai,deepseek.com,qwen.ai,qwenlm.github.io,alibabacloud.com,ai.meta.com,livecodebench.github.io,swebench.com,lmarena.ai,artificialanalysis.ai,aider.chat

# Optional USD-per-1k-token tariff overrides. Leave blank to use built-in
# provider tariffs where recognised. DeepSeek V4 Flash/Pro use the official
# cache-hit, cache-miss, and output rates current on 2026-07-26.
ESTIMATED_INPUT_TOKEN_COST_PER_1K=
ESTIMATED_CACHED_INPUT_TOKEN_COST_PER_1K=
ESTIMATED_OUTPUT_TOKEN_COST_PER_1K=

# Agent loop budgets (bound latency and cost per brief)
AGENT_MAX_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=12
# User research-depth presets: Quick, Balanced, and Deep. The hard limit caps
# every preset even if a deployment configures a larger value.
AGENT_QUICK_SEARCH_CALLS=1
AGENT_MAX_SEARCH_CALLS=3
AGENT_DEEP_SEARCH_CALLS=5
AGENT_SEARCH_CALLS_HARD_LIMIT=5

# Agent search auto-backfill: when the model's search_papers call finds no local
# paper at/above the relevance floor, transparently fetch fresh arXiv papers for
# that query, index them, and re-search once. Makes cold-start questions work
# without the model having to choose fetch_arxiv itself. Deduped per query per
# run; adds one arXiv round-trip on the first search of an uncovered topic.
AGENT_SEARCH_AUTO_BACKFILL=true
# SPECTER2 cosine floor: a best local hit below this counts as "topic not
# covered" and triggers backfill. Calibrated against the seeded benchmark corpus
# (scripts/calibrate_backfill_floor.py): covered-topic best hits measured
# 0.7318-0.8162, an uncovered topic ~0.71-0.73. Re-run the calibration if the
# embedding model or corpus mix changes.
AGENT_SEARCH_BACKFILL_MIN_SCORE=0.72
# Recency-sensitive questions ("latest", "recent", "state of the art") force one
# arXiv backfill sorted by submission date even when a stale local hit clears the
# generic score floor. Fresh candidates are scored directly by id before this
# fraction reserves their share of the displayed ranking.
AGENT_RECENCY_AUTO_BACKFILL=true
AGENT_RECENCY_CANDIDATE_FRACTION=0.5
# Long descriptive model queries are compacted into arXiv keywords for the
# recency backfill when they contain no more than this many words.
AGENT_RECENCY_QUERY_EXPANSION_MAX_WORDS=60

# Transcript compaction (reduce repeated prompt tokens across agent turns)
TRANSCRIPT_KEEP_RECENT_TOOL_RESULTS=1
TRANSCRIPT_FULL_TEXT_EXCERPT_CHARS=2500
TRANSCRIPT_ABSTRACT_EXCERPT_CHARS=500

# Full-text tool budgets
FULL_TEXT_CHAR_BUDGET=12000
FULL_TEXT_MAX_PAPERS=3
FULL_TEXT_TOTAL_PAPER_BUDGET=3
FULL_TEXT_TIMEOUT_S=20
# PDF_EXTRACTOR=auto tries Docling when installed, then falls back to pypdf.
# Set pypdf for the lightweight always-installed path, or docling to require
# the optional layout-aware backend.
PDF_EXTRACTOR=auto

QDRANT_URL=http://localhost:6333
# Embedded local mode (no server/Docker): persist Qdrant on disk in-process.
# When set, takes precedence over QDRANT_URL. Docker Compose clears this value
# so its API container uses the Qdrant service instead.
# For a warm standing corpus without Docker, seed one and point the app at it:
#   uv run python scripts/seed_corpus.py         # writes .local/qdrant-corpus
#   QDRANT_PATH=.local/qdrant-corpus VECTOR_STORE_BACKEND=qdrant
# Embedded mode is single-process: stop the app before re-running the seed.
QDRANT_PATH=.local/qdrant-corpus
QDRANT_COLLECTION=arxiv_papers
VECTOR_STORE_BACKEND=qdrant

EMBEDDING_MODEL=allenai/specter2_base
EMBEDDING_DOCUMENT_ADAPTER=allenai/specter2
EMBEDDING_QUERY_ADAPTER=allenai/specter2_adhoc_query
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=768

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LOG_LEVEL=INFO
STRUCTURED_LOGS=true
RUN_RECORDS_DIR=.local/run-records
# Treat run-record persistence as critical: probe the directory at startup and
# let write failures propagate. Default (false) keeps writes best-effort so
# observability IO faults never break the agent stream.
RUN_RECORDS_REQUIRED=false

DEFAULT_MAX_PAPERS=12
MAX_INGEST_RESULTS=200
MAX_RETRIEVAL_RESULTS=20
RETRIEVAL_MIN_SCORE=0.0
# arXiv fetch ordering: relevance (default) | submitted_date | last_updated.
# Relevance avoids biasing the corpus toward the newest submissions.
ARXIV_SORT=relevance
# /papers/search expansion + optional coverage. Expansion rewrites short
# keyword queries into an abstract-like sentence (LLM, HyDE-style) before
# embedding. Backfill fetches fresh arXiv papers for slower coverage beyond the
# already-indexed corpus when explicitly enabled.
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_WORDS=12
SEARCH_AUTO_BACKFILL=false
SEARCH_BACKFILL_MAX_PAPERS=25
SEARCH_BACKFILL_QUERY_EXPANSION=true

# Optional precision reranking. Disabled by default because the cross-encoder
# model must be downloaded/cached before use.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=40
