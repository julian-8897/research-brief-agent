# Synthesis backend: anthropic (native Claude) or openai (OpenAI-compatible)
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=1800
LLM_TEMPERATURE=0.2

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI-compatible (OpenAI, DeepSeek, local models, OpenRouter, codex/opencode).
# Set OPENAI_BASE_URL to point at a non-OpenAI compatible endpoint.
# DeepSeek V4: LLM_PROVIDER=openai, OPENAI_BASE_URL=https://api.deepseek.com
# Ollama (local): OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_BASE_URL=

# Agent loop budgets (bound latency and cost per brief)
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_SEARCH_CALLS=4

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=arxiv_papers
VECTOR_STORE_BACKEND=qdrant

EMBEDDING_MODEL=sentence-transformers/allenai-specter
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=768

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

DEFAULT_MAX_PAPERS=12
MAX_INGEST_RESULTS=200
MAX_RETRIEVAL_RESULTS=20
