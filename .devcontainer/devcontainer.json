{
  "name": "Research Brief Agent",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "AGENTS.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user uv && uv sync --dev",
  "postAttachCommand": {
    "server": "uv run uvicorn src.api.main:app --host 0.0.0.0 --port 8000"
  },
  "portsAttributes": {
    "8000": {
      "label": "API + console",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000
  ]
}
